{
  "_nota": "CIERRE: tras Rechazar, Cancelar o caducar, una sesion minima cierra las pestanas de la sesion de la fase 1. Solo ve y cierra pestanas.",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__tabs_close_mcp",
      "mcp__claude-in-chrome__select_browser"
    ],
    "deny": [
      "mcp__claude-in-chrome__computer",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__form_input",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "mcp__claude-in-chrome__javascript_tool",
      "mcp__claude-in-chrome__browser_batch",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__get_page_text"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I __REPO__/ops/chrome-dominios.py"
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__select_browser",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I __REPO__/panel/agente-asistente/hook-navegador.py"
          }
        ]
      }
    ]
  }
}
